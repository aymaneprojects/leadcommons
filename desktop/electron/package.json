{
  "name": "pepite-desktop",
  "productName": "Pepite",
  "version": "0.1.1",
  "description": "Free, open-source prospecting on your own computer.",
  "author": "Pepite contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/aymaneprojects/leadcommons",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.pepite.desktop",
    "productName": "Pepite",
    "copyright": "Pepite contributors. AGPL-3.0-or-later.",
    "directories": {
      "output": "../../dist-desktop",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/pepite-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Pepite-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pepite",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Pepite-${version}-windows-x64-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "Pepite-${version}-macos-arm64.${ext}",
      "title": "Pepite"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "synopsis": "Free, open-source prospecting on your own computer",
      "maintainer": "Pepite contributors <noreply@users.noreply.github.com>",
      "executableName": "pepite-desktop"
    },
    "appImage": {
      "artifactName": "Pepite-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Pepite-${version}-linux-amd64.${ext}"
    },
    "publish": null
  }
}
