# Copy to deploy/.env (or ~/pepite/.env on the server) and fill in.
# Never commit the real file.

# Domain whose DNS A/AAAA record points at your server, e.g. leads.example.com
DOMAIN=leads.example.com

# Database password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Login password hash. Generate (asks for a password, prints a hash):
#   docker run --rm -it ghcr.io/aymaneprojects/leadcommons:latest pepite hash-password
# or, if installed locally:  pepite hash-password
# If the hash contains "$", keep the single quotes so Docker Compose does not expand it.
PEPITE_PASSWORD_HASH='scrypt$...'

# Session signing key. Generate: openssl rand -hex 32
PEPITE_SECRET_KEY=change-me

# Optional: your country, as a locale (fr_FR, en_GB, nb_NO, de_DE...). On first start the app
# downloads the companies of that country (France is 439 MB). Without it the app starts with a
# small sample; add countries later in Settings > Data packs.
# PEPITE_LOCALE=fr_FR
